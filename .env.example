# Copy to .env. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME
# False ONLY for localhost HTTP. Production requires HTTPS and True.
COOKIE_SECURE=False
APP_URL=http://localhost:5173
# Google OAuth client type: Web application. Register APP_URL as a JavaScript origin.
# Popup ID-token login needs only this public client ID; no client secret or redirect URI.
GOOGLE_CLIENT_ID=replace_with_web_client_id.apps.googleusercontent.com
OPENROUTER_API_KEY=replace_with_regular_openrouter_inference_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=openai/whisper-large-v3
OPENROUTER_SUMMARY_MODEL=deepseek/deepseek-v4.1-flash-1017
# Set False when changing to an STT model that cannot return verbose_json.
OPENROUTER_STT_TIMESTAMPS=True
AUDIO_CHUNK_SECONDS=180
STT_ADAPTIVE=true
STT_INITIAL_CONCURRENCY=2
STT_MAX_CONCURRENCY=12
STT_MIN_CONCURRENCY=1
STT_CONCURRENCY_LEVELS=[12,10,8,6,4,2,1]
STT_EXTRACT_CONCURRENCY=2
STT_GLOBAL_CONCURRENCY=12
STT_OVERLAP_SECONDS=1.5
SUMMARY_CHUNK_CHARS=24000
# 0 removes the meeting upload size limit. A positive value optionally sets a cap.
MAX_UPLOAD_MB=0
MAX_DURATION_SECONDS=14400
# Defaults use data/sumx.db and data/media under the project root.
# DATABASE_URL=postgresql+psycopg://user:password@localhost/sumx
# STORAGE_DIR=C:/private/sumx-media
FFMPEG=ffmpeg
FFPROBE=ffprobe

# Preset voices use OpenRouter Voxtral. Cloned voices use Modal GPUs, set in modal_service/config.py.
# Reference transcript checking uses STT above.
TTS_ENABLED=true
TTS_DEFAULT_VOICE=en_paul_neutral
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
OPENROUTER_TTS_MODEL=mistralai/voxtral-mini-tts-3-0
QWEN_TTS_CHUNK_CHARS=240
QWEN_TTS_TIMEOUT=3200

# Cloned voices only. Preset sampling/chunking is independent.
QWEN_CLONE_CHUNK_WORDS=22
QWEN_CLONE_GAP_MS=200
QWEN_CLONE_TEMPERATURE=0.65
QWEN_CLONE_TOP_K=30
QWEN_CLONE_TOP_P=0.9
QWEN_CLONE_REPETITION_PENALTY=1.15
QWEN_CLONE_MAX_NEW_TOKENS=600
QWEN_CLONE_DURATION_RATIO=2
QWEN_CLONE_MAX_SILENCE_SECONDS=3
QWEN_CLONE_SILENCE_DB=-45
QWEN_CLONE_NON_STREAMING_MODE=true
# Optional fixed seed for reproducible testing; otherwise each request gets a logged random seed.
# QWEN_CLONE_SEED=7000
# Development only: saves generated debug WAVs in data/clone-debug, never reference recordings/transcripts.
QWEN_CLONE_DEBUG=false

# Backend-only Modal credentials. Never expose these to the frontend or commit real values.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# MODAL_ENVIRONMENT=
