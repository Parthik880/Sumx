# Reference only: FastAPI and both workers read the PROJECT ROOT .env.
# Copy ../.env.example to ../.env for the full server configuration.
SESSION_SECRET=CHANGE_ME
COOKIE_SECURE=False
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace_with_web_client_id.apps.googleusercontent.com
OPENROUTER_API_KEY=replace_with_regular_openrouter_inference_key
OPENROUTER_STT_MODEL=openai/whisper-large-v3
OPENROUTER_SUMMARY_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_TTS_MODEL=mistralai/voxtral-mini-tts-2603
LOCAL_VOICE_CLONING_ENABLED=true
LOCAL_TTS_PROVIDER=faster_qwen3
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
